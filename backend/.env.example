# PostgreSQL Cloud Database URL (Neon)
# Formato: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_sample@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Puerto del servidor
PORT=5000

# Clave secreta para firma y verificación de tokens JWT
JWT_SECRET=el_buen_corte_super_secret_jwt_key_2026_production

# Cloudinary (Almacenamiento de fotos de productos, logos y portadas)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
